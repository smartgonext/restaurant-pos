{
  "name": "@restaurant-saas/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "echo \"No TS build needed (JS project)\"",
    "start": "node src/server.js",
    "postinstall": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.1",
    "@prisma/client": "^5.22.0",
    "abstract-logging": "^2.0.1",
    "avvio": "^8.3.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^2.0.9",
    "dotenv": "^16.4.7",
    "exceljs": "^4.3.0",
    "fast-decode-uri-component": "^1.0.1",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "9.0.0",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.13.0",
    "pino-pretty": "^10.3.1",
    "process-warning": "^3.0.0",
    "proxy-addr": "^2.0.7",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.22.0"
  }
}
