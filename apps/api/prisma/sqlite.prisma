 taxRate Decimal @default(0)
 quantity Decimal
 total Decimal
 addedBy String
 addedAt DateTime @default(now())
 removedAt DateTime?
 removedBy String?
 removeReason String?
 isRemoved Boolean @default(false)

 token BakeryToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
 menuItem MenuItem @relation(fields: [menuItemId], references: [id])
 // Optional: link to inventory item MRP chosen at sale time (for retail items)
 inventoryItemMRPId Int?
 purchaseRate Decimal?
 inventoryItemMRP InventoryItemMRP? @relation(fields: [inventoryItemMRPId], references: [id])
}

