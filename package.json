{
  "name": "restaurant-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Offline restaurant ordering Electron app",
  "author": "Restaurant SaaS",
  "main": "main.js",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @restaurant-saas/web dev",
    "dev:api": "pnpm --filter @restaurant-saas/api dev",
    "build": "pnpm --parallel -r run build",
    "lint": "pnpm --parallel -r run lint",
    "db:push": "pnpm --filter @restaurant-saas/api db:push",
    "db:seed": "pnpm --filter @restaurant-saas/api db:seed",
    "db:studio": "pnpm --filter @restaurant-saas/api db:studio",
    "db:generate": "pnpm --filter @restaurant-saas/api db:generate",
    "electron:dev": "electron electron/main.js",
    "cleanup-old-builds": "powershell -NoProfile -Command \"Get-Process -Name restaurant-saas -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; if (Test-Path 'dist4') { Remove-Item -Recurse -Force 'dist4' -ErrorAction SilentlyContinue }; if (Test-Path 'dist5') { Remove-Item -Recurse -Force 'dist5' -ErrorAction SilentlyContinue }; if (Test-Path 'dist6') { Remove-Item -Recurse -Force 'dist6' -ErrorAction SilentlyContinue }; exit 0\"",
    "electron:build": "node scripts/electron-build-wrapper.mjs",
    "electron:build:win32": "node scripts/build-target.js win32",
    "electron:build:win64": "node scripts/build-target.js win64",
    "prepare-electron": "pnpm --filter @restaurant-saas/web build && pnpm --filter @restaurant-saas/api build && node apps/api/scripts/generate-electron-sqlite-schema.mjs && cd apps/api && npm install && pnpm exec prisma generate --schema=prisma/schema.electron.sqlite.prisma && cmd /c \"set DATABASE_URL=file:../sqlite-template/dev.db&& pnpm exec prisma db push --schema=prisma/schema.electron.sqlite.prisma\" && node -e \"const fs=require('fs'); const path=require('path'); const src='apps/api/node_modules/.prisma/client'; const dst='apps/api/node_modules/@prisma/client/.prisma/client'; if (fs.existsSync(src)) { fs.mkdirSync(path.dirname(dst), { recursive: true }); fs.cpSync(src, dst, { recursive: true }); }\" && node scripts/pack-runtime-assets.cjs && cd ../.. && node apps/api/scripts/fix-dist-import-extensions.mjs && node apps/api/scripts/ensure-sqlite-template.mjs"
  },
  "build": {
    "appId": "com.company.restorent",
    "productName": "restorent",
    "asar": true,
    "compression": "maximum",
    "asarUnpack": [
      "**/*.node",
      "apps/api/whisper/**",
      "apps/api/**",
      "apps/api/node_modules/**"
    ],
    "npmRebuild": true,
    "files": [
      "main.js",
      "preload.js",
      "config/**",
      "apps/api/**",
      "apps/api/node_modules/**",
      "apps/web/dist/**",
      "!**/node_modules/*/{test,__tests__,tests,example,examples,docs,doc}",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.zip",
      "!**/*.tar.gz"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "apps/web/dist"
      },
      {
        "from": "apps/api/node_modules",
        "to": "app.asar.unpacked/apps/api/node_modules"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "apps/api/sqlite-template",
        "to": "apps/api/sqlite-template"
      }
    ],
    "directories": {
      "output": "dist64"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "pnpm": {
    "overrides": {
      "uuid": "8.3.0"
    }
  },
  
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "fastify": "^4.26.0",
    "socket.io": "^4.7.4",
    "dotenv": "^17.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.1",
    "@prisma/client": "^5.10.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "9.0.0",
    "nodemailer": "^6.9.8",
    "pino-pretty": "^10.3.1",
    "proxy-addr": "^2.0.7",
    "qrcode": "^1.5.3",
    "zod": "^3.22.4",
    "exceljs": "^4.3.0",
    "pdfkit": "^0.13.0",
    "bwip-js": "^2.0.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "fast-decode-uri-component": "^1.0.1",
    "avvio": "^8.3.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pnpm": "^10.32.1"
  }
}
