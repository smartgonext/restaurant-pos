model BakeryToken {
 id Int @id @default(autoincrement())
 restaurantId Int
 branchId Int
 subPosId Int?
 tokenNumber Int
 qrCode String @unique
 status String @default("open")
 customerId Int?
 customerName String?
 customerPhone String?
 orderId Int? @unique
 loyaltyPointsEarned Int @default(0)
 loyaltyPointsClaimed Int @default(0)
 discountApplied Decimal @default(0)
 subtotal Decimal @default(0)
 sgst Decimal @default(0)
 cgst Decimal @default(0)
 igst Decimal @default(0)
 total Decimal @default(0)
 paidAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
 customer Customer? @relation(fields: [customerId], references: [id])
 subPos SubPOSTerminal? @relation(fields: [subPosId], references: [id])
 order Order? @relation(fields: [orderId], references: [id])
 items BakeryTokenItem[]
 payments BakeryTokenPayment[]
 edits BakeryTokenEdit[]
 returns BakeryTokenReturn[] @relation("original_returns")
}

model BakeryTokenItem {
 id Int @id @default(autoincrement())
 tokenId Int
