generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// SUPERADMIN LAYER
// ─────────────────────────────────────────

model SuperAdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("superadmin")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  monthlyPrice  Decimal?       @db.Decimal(10, 2)
  annualPrice   Decimal?       @db.Decimal(10, 2)
  lifetimePrice Decimal?       @db.Decimal(10, 2)
  isRecommended Boolean        @default(false)
  isDefault     Boolean        @default(false)
  modules       Json
  trialDays     Int            @default(30)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Restaurant {
  id               Int                  @id @default(autoincrement())
  name             String
  slug             String               @unique
  email            String               @unique
  phone            String?
  address          String?              @db.Text
  logo             String?
  status           String               @default("active")
  requiresApproval Boolean              @default(false)
  approvedAt       DateTime?
  enabledModules   Json                 @default("[]")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  subscription     Subscription?
  branches         Branch[]
  staff            Staff[]
  menus            Menu[]
  customers        Customer[]
  orders           Order[]
  expenses         Expense[]
  cashRegisters    CashRegister[]
  inventoryItems   InventoryItem[]
  kitchens         Kitchen[]
  settings         RestaurantSettings?
  loyaltyProgram   LoyaltyProgram?
  hotelRoomTypes   HotelRoomType[]
  hotelRooms       HotelRoom[]
  hotelGuests      HotelGuest[]
  hotelReservations HotelReservation[]
  hotelStays       HotelStay[]
  hotelFolioCharges HotelFolioCharge[]
  hotelFolioPayments HotelFolioPayment[]
  hotelHousekeepingTasks HotelHousekeepingTask[]
  hotelVenues      HotelVenue[]
  hotelEvents      HotelEvent[]
  hotelRatePlans   HotelRatePlan[]
}

model Subscription {
  id              Int                   @id @default(autoincrement())
  restaurantId    Int                   @unique
  packageId       Int
  billingCycle    String
  status          String                @default("trial")
  startDate       DateTime
  endDate         DateTime?
  nextPaymentDate DateTime?
  transactionId   String?
  paymentGateway  String?
  amount          Decimal?              @db.Decimal(10, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  restaurant      Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  package         Package               @relation(fields: [packageId], references: [id])
  payments        SubscriptionPayment[]
}

model SubscriptionPayment {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("USD")
  gateway        String
  gatewayTxnId   String?
  status         String
  receiptUrl     String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model OfflinePaymentRequest {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  packageId    Int
  billingCycle String
  paymentBy    String?
  status       String   @default("pending")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────
// RESTAURANT LAYER
// ─────────────────────────────────────────

model Branch {
  id           Int            @id @default(autoincrement())
  restaurantId Int
  name         String
  address      String?        @db.Text
  phone        String?
  isDefault    Boolean        @default(false)
  isActive     Boolean        @default(true)
  openTime     String?
  closeTime    String?
  createdAt    DateTime       @default(now())

  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff        Staff[]
  areas        Area[]
  orders       Order[]
  cashRegisters CashRegister[]
}

model Staff {
  id           Int             @id @default(autoincrement())
  restaurantId Int
  branchId     Int?
  name         String
  email        String
  password     String
  role         String          @default("waiter")
  phone        String?
  avatar       String?
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  theme        String          @default("dark")
  language     String          @default("en")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id])
  orders       Order[]
  waiterRequests WaiterRequest[]

  @@unique([restaurantId, email])
}

model RestaurantSettings {
  id                     Int        @id @default(autoincrement())
  restaurantId           Int        @unique
  currency               String     @default("USD")
  currencySymbol         String     @default("$")
  taxMode                String     @default("order")
  sgstRate               Decimal    @default(0) @db.Decimal(5, 2)
  cgstRate               Decimal    @default(0) @db.Decimal(5, 2)
  timezone               String     @default("UTC")
  orderPrefix            String     @default("ORD")
  kotPrefix              String     @default("KOT")
  receiptTemplate        Json?
  deliveryFee            Decimal    @default(0) @db.Decimal(10, 2)
  minOrderAmount         Decimal    @default(0) @db.Decimal(10, 2)
  allowDineIn            Boolean    @default(true)
  allowDelivery          Boolean    @default(true)
  allowPickup            Boolean    @default(true)
  whatsappEnabled        Boolean    @default(false)
  whatsappToken          String?
  webhookUrls            Json?
  loyaltyEnabled         Boolean    @default(false)
  kioskEnabled           Boolean    @default(false)
  customerDisplayEnabled Boolean    @default(false)
  presetAmounts          Json?
  additionalCharges      Json?
  cancellationReasons    Json?
  refundReasons          Json?
  aboutUs                Json?
  customerSiteConfig     Json?
  theme                  Json?
  updatedAt              DateTime   @updatedAt

  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// MENU
// ─────────────────────────────────────────

model Menu {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  name         String
  description  String?
  image        String?
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  tableMenus   TableMenu[]
}

model ItemCategory {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  name         String
  description  String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  menuItems    MenuItem[]
}

model MenuItem {
  id                 Int                @id @default(autoincrement())
  restaurantId       Int
  menuId             Int
  categoryId         Int?
  name               String
  description        String?
  price              Decimal            @db.Decimal(10, 2)
  image              String?
  isVeg              Boolean            @default(true)
  isAvailable        Boolean            @default(true)
  showOnCustomerSite Boolean            @default(true)
  preparationTime    Int?
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  menu               Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category           ItemCategory?      @relation(fields: [categoryId], references: [id])
  itemModifiers      ItemModifier[]
  kotItems           KOTItem[]
  recipeIngredients  RecipeIngredient[]
}

model ModifierGroup {
  id           Int            @id @default(autoincrement())
  restaurantId Int
  name         String
  options      Json
  createdAt    DateTime       @default(now())

  itemModifiers ItemModifier[]
}

model ItemModifier {
  id              Int           @id @default(autoincrement())
  restaurantId    Int
  menuItemId      Int
  modifierGroupId Int
  isRequired      Boolean       @default(false)
  allowMultiple   Boolean       @default(false)
  createdAt       DateTime      @default(now())

  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────

model Area {
  id           Int      @id @default(autoincrement())
  branchId     Int
  restaurantId Int
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables       Table[]
}

model Table {
  id           Int             @id @default(autoincrement())
  areaId       Int
  restaurantId Int
  name         String
  capacity     Int             @default(4)
  status       String          @default("available")
  qrToken      String          @unique @default(cuid())
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  area         Area            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  orders       Order[]
  tableMenus   TableMenu[]
  reservations Reservation[]
  waiterRequests WaiterRequest[]
}

model TableMenu {
  id       Int     @id @default(autoincrement())
  tableId  Int
  menuId   Int
  isActive Boolean @default(true)

  table    Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// ORDERS & KOT
// ─────────────────────────────────────────

model Customer {
  id           Int                  @id @default(autoincrement())
  restaurantId Int
  name         String
  email        String?
  phone        String?
  address      String?              @db.Text
  loyaltyPoints Int                 @default(0)
  loyaltyStamps Int                 @default(0)
  totalOrders  Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Order {
  id               Int            @id @default(autoincrement())
  restaurantId     Int
  branchId         Int?
  tableId          Int?
  customerId       Int?
  staffId          Int?
  orderNumber      String
  type             String         @default("dine_in")
  status           String         @default("placed")
  waiterAcceptance String         @default("pending")
  pax              Int            @default(1)
  subtotal         Decimal        @default(0) @db.Decimal(10, 2)
  sgst             Decimal        @default(0) @db.Decimal(10, 2)
  cgst             Decimal        @default(0) @db.Decimal(10, 2)
  discount         Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  tip              Decimal        @default(0) @db.Decimal(10, 2)
  total            Decimal        @default(0) @db.Decimal(10, 2)
  note             String?        @db.Text
  cancelReason     String?
  isDraft          Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch           Branch?        @relation(fields: [branchId], references: [id])
  table            Table?         @relation(fields: [tableId], references: [id])
  customer         Customer?      @relation(fields: [customerId], references: [id])
  staff            Staff?         @relation(fields: [staffId], references: [id])
  kots             KOT[]
  payments         OrderPayment[]
  refunds          Refund[]
}

model KOT {
  id           Int       @id @default(autoincrement())
  orderId      Int
  restaurantId Int
  kitchenId    Int?
  kotNumber    String
  status       String    @default("pending")
  printedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchen      Kitchen?  @relation(fields: [kitchenId], references: [id])
  items        KOTItem[]
}

model KOTItem {
  id           Int      @id @default(autoincrement())
  kotId        Int
  menuItemId   Int
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  modifiers    Json?
  note         String?
  status       String   @default("pending")
  removedBy    Int?
  removeReason String?
  removedAt    DateTime?

  kot          KOT      @relation(fields: [kotId], references: [id], onDelete: Cascade)
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
}

model OrderPayment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  amount        Decimal  @db.Decimal(10, 2)
  method        String
  transactionId String?
  gatewayRef    String?
  isDue         Boolean  @default(false)
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund        Refund?
}

model Refund {
  id             Int           @id @default(autoincrement())
  orderId        Int
  paymentId      Int?          @unique
  refundType     String
  reason         String?
  originalAmount Decimal       @db.Decimal(10, 2)
  refundedAmount Decimal       @db.Decimal(10, 2)
  processedById  Int?
  gatewayRef     String?
  createdAt      DateTime      @default(now())

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment        OrderPayment? @relation(fields: [paymentId], references: [id])
}

// ─────────────────────────────────────────
// WAITER REQUESTS & RESERVATIONS
// ─────────────────────────────────────────

model WaiterRequest {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  tableId      Int
  staffId      Int?
  status       String    @default("pending")
  attendedAt   DateTime?
  createdAt    DateTime  @default(now())

  table        Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  staff        Staff?    @relation(fields: [staffId], references: [id])
}

model Reservation {
  id            Int       @id @default(autoincrement())
  restaurantId  Int
  tableId       Int?
  customerName  String
  customerEmail String?
  customerPhone String?
  partySize     Int
  date          DateTime
  startTime     String
  endTime       String?
  status        String    @default("confirmed")
  note          String?
  createdAt     DateTime  @default(now())

  table         Table?    @relation(fields: [tableId], references: [id])
}

// ─────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────

model ExpenseCategory {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  name         String
  description  String?
  createdAt    DateTime  @default(now())

  expenses     Expense[]
}

model Expense {
  id            Int             @id @default(autoincrement())
  restaurantId  Int
  categoryId    Int
  title         String
  amount        Decimal         @db.Decimal(10, 2)
  expenseDate   DateTime
  paymentDate   DateTime?
  dueDate       DateTime?
  paymentStatus String          @default("pending")
  paymentMethod String?
  description   String?         @db.Text
  receiptUrl    String?
  createdAt     DateTime        @default(now())

  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
}

// ─────────────────────────────────────────
// CASH REGISTER
// ─────────────────────────────────────────

model CashRegister {
  id               Int                   @id @default(autoincrement())
  restaurantId     Int
  branchId         Int
  name             String
  type             String                @default("main")
  isActive         Boolean               @default(true)
  forceOpenOnLogin Boolean               @default(false)
  allowedRoles     Json?
  createdAt        DateTime              @default(now())

  restaurant       Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch           Branch                @relation(fields: [branchId], references: [id])
  sessions         CashRegisterSession[]
  denominations    Denomination[]
}

model CashRegisterSession {
  id             Int               @id @default(autoincrement())
  registerId     Int
  cashierId      Int
  openingBalance Decimal           @db.Decimal(10, 2)
  closingBalance Decimal?          @db.Decimal(10, 2)
  expectedCash   Decimal?          @db.Decimal(10, 2)
  countedCash    Decimal?          @db.Decimal(10, 2)
  discrepancy    Decimal?          @db.Decimal(10, 2)
  status         String            @default("open")
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  approvedBy     Int?
  approvedAt     DateTime?
  note           String?

  register       CashRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  transactions   CashTransaction[]
}

model CashTransaction {
  id          Int                 @id @default(autoincrement())
  sessionId   Int
  type        String
  amount      Decimal             @db.Decimal(10, 2)
  reason      String?
  referenceId Int?
  createdAt   DateTime            @default(now())

  session     CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Denomination {
  id         Int          @id @default(autoincrement())
  registerId Int
  name       String
  value      Decimal      @db.Decimal(10, 2)
  type       String
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  register   CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────

model InventoryUnit {
  id             Int             @id @default(autoincrement())
  restaurantId   Int
  name           String
  symbol         String
  createdAt      DateTime        @default(now())

  inventoryItems InventoryItem[]
}

model InventoryItemCategory {
  id             Int             @id @default(autoincrement())
  restaurantId   Int
  name           String
  createdAt      DateTime        @default(now())

  inventoryItems InventoryItem[]
}

model InventoryItem {
  id                 Int                    @id @default(autoincrement())
  restaurantId       Int
  categoryId         Int
  unitId             Int
  name               String
  image              String?
  thresholdQty       Decimal                @default(0) @db.Decimal(10, 3)
  currentStock       Decimal                @default(0) @db.Decimal(10, 3)
  costPerUnit        Decimal                @default(0) @db.Decimal(10, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  restaurant         Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category           InventoryItemCategory  @relation(fields: [categoryId], references: [id])
  unit               InventoryUnit          @relation(fields: [unitId], references: [id])
  movements          InventoryMovement[]
  recipeIngredients  RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]
}

model InventoryMovement {
  id           Int           @id @default(autoincrement())
  restaurantId Int
  itemId       Int
  type         String
  quantity     Decimal       @db.Decimal(10, 3)
  note         String?
  referenceId  Int?
  staffId      Int?
  createdAt    DateTime      @default(now())

  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           Int                @id @default(autoincrement())
  restaurantId Int
  menuItemId   Int                @unique
  yield        Decimal            @default(1) @db.Decimal(10, 3)
  yieldUnit    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  ingredients  RecipeIngredient[]
}

model RecipeIngredient {
  id              Int           @id @default(autoincrement())
  recipeId        Int
  inventoryItemId Int
  menuItemId      Int
  quantity        Decimal       @db.Decimal(10, 3)

  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
}

model Supplier {
  id             Int             @id @default(autoincrement())
  restaurantId   Int
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?         @db.Text
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  restaurantId Int
  supplierId   Int
  orderNumber  String
  status       String              @default("pending")
  total        Decimal             @default(0) @db.Decimal(10, 2)
  expectedDate DateTime?
  receivedAt   DateTime?
  note         String?             @db.Text
  createdAt    DateTime            @default(now())

  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  inventoryItemId Int
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

// ─────────────────────────────────────────
// KITCHENS
// ─────────────────────────────────────────

model Kitchen {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  name         String
  type         String     @default("food")
  printerName  String?
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  menuItemIds  Json?
  createdAt    DateTime   @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kots         KOT[]
}

// ─────────────────────────────────────────
// LOYALTY
// ─────────────────────────────────────────

model LoyaltyProgram {
  id              Int                  @id @default(autoincrement())
  restaurantId    Int                  @unique
  pointsPerAmount Decimal              @default(1) @db.Decimal(10, 2)
  amountPerPoint  Decimal              @default(0.01) @db.Decimal(10, 4)
  stampsPerVisit  Int                  @default(1)
  stampsForReward Int                  @default(10)
  rewardValue     Decimal              @default(50) @db.Decimal(10, 2)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions    LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               Int            @id @default(autoincrement())
  restaurantId     Int
  customerId       Int
  loyaltyProgramId Int
  type             String
  points           Int?
  stamps           Int?
  orderId          Int?
  note             String?
  createdAt        DateTime       @default(now())

  customer         Customer       @relation(fields: [customerId], references: [id])
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id])
}

// ─────────────────────────────────────────
// DELIVERY EXECUTIVES
// ─────────────────────────────────────────

model DeliveryExecutive {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  name         String
  phone        String
  email        String?
  partnerCode  String   @unique
  status       String   @default("available")
  totalOrders  Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────
// AI INSIGHTS
// ─────────────────────────────────────────

model AIInsight {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  type         String
  title        String
  content      Json
  generatedAt  DateTime  @default(now())
  expiresAt    DateTime?
  isRead       Boolean   @default(false)
}
