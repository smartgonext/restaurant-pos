// ─────────────────────────────────────────
// PRODUCTION & WAREHOUSE EXTENSIONS
// ─────────────────────────────────────────

model ProductionRecipe {
  id              Int                        @id @default(autoincrement())
  restaurantId    Int
  inventoryItemId Int
  name            String
  description     String?
  targetQuantity  Decimal
  unitId          Int
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  inventoryItem   InventoryItem              @relation(fields: [inventoryItemId], references: [id])
  unit            InventoryUnit              @relation(fields: [unitId], references: [id])
  ingredients     ProductionRecipeIngredient[]
  productionRuns  ProductionRun[]
}

model ProductionRecipeIngredient {
  id                 Int              @id @default(autoincrement())
  recipeId           Int
  inventoryItemId    Int
  quantity           Decimal

  recipe             ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id])
}

model ProductionRun {
  id                Int                  @id @default(autoincrement())
  restaurantId      Int
  branchId          Int
  recipeId          Int
  quantityProduced  Decimal
  overheadCost      Decimal              @default(0)
  costOfProduction  Decimal
  batchNumber       String               @unique
  status            String               @default("completed")
  wasteQuantity     Decimal              @default(0)
  wasteReason       String?
  notes             String?
  staffId           Int?
  createdAt         DateTime             @default(now())

  recipe            ProductionRecipe     @relation(fields: [recipeId], references: [id])
  ingredientsUsed   ProductionRunIngredient[]
}

model ProductionRunIngredient {
  id                 Int              @id @default(autoincrement())
  productionRunId    Int
  inventoryItemId    Int
  quantityConsumed   Decimal
  costPerUnit        Decimal

  productionRun      ProductionRun    @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id])
}

model WarehouseTransfer {
  id                Int                  @id @default(autoincrement())
  restaurantId      Int
  fromBranchId      Int
  toBranchId        Int
  transferNumber    String               @unique
  transferType      String               @default("outbound")
  parentTransferId  Int?
  status            String               @default("pending")
  shippedAt         DateTime?
  receivedAt        DateTime?
  notes             String?
  shipperStaffId    Int?
  receiverStaffId   Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items             WarehouseTransferItem[]
}

model WarehouseTransferItem {
  id                 Int               @id @default(autoincrement())
  transferId         Int
  inventoryItemId    Int
  quantityShipped    Decimal
  quantityReceived   Decimal           @default(0)
  quantityDamaged    Decimal           @default(0)
  unitCost           Decimal

  transfer           WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem     @relation(fields: [inventoryItemId], references: [id])
}

